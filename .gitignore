#Venv 
.venv
venv/
.venv-q1-training/

#pycache
QCNN/__pycache__
QCNN/*/__pycache__
*.pyc

#for testing and checking modules and snippets
implementationTests/
implementationTests/*

#Results
# Results/*
Results/Cache/
# Rewritten by main.py on every run. The immutable headline identity lives in
# Results/headline_manifest.json, which IS tracked.
Results/metadata.json
# Per-run outputs (UPGRADE_PLAN.md M0.5): isolated, regenerable, not evidence
# until a phase promotes them.
Results/runs/
Results/Weights/run_seed*.npz
training_log.txt
training_summary.txt


# output.txt
datasets/images/*
datasets/*.*
datasets/MNIST/
datasets/FashionMNIST/
datasets/KMNIST/
graphify-out/
# Per-run trainer transcripts from the experiment grid: chatty, large, and
# regenerable. The per-seed metric JSONs and split manifests beside them ARE
# evidence and stay tracked.
Results/experiments/**/*.log
# Temporary Q1 command transcripts are reproducible and are not evidence.
Results/evidence/*.log
# Q1 fast-track per-run artifacts are regenerable and may contain large binary
# weights/prediction archives; commit their validated metric/evidence JSON only.
Results/q1_comparison/runs/
# Q1 campaign transcripts are regenerable and may include host-specific paths.
Results/q1_comparison/experiments/**/*.log
Results/q1_pooling_transfer/runs/
# Q1 transfer transcripts are reproducible and are not evidence.
Results/q1_pooling_transfer/experiments/**/*.log
Results/smoke/

# Final submission archives are deterministic release outputs built from a
# clean commit. Keep them local (or attach them to a release) rather than
# storing generated ZIP files in Git.
submission_dist/

# LaTeX intermediates from building the paper.
paper/*.aux
paper/*.log
paper/*.out
